# Only send frontend build inputs and the runtime configuration.
*
!package.json
!yarn.lock
!index.html
!vite.config.js
!src/
!src/**
!public/
!public/**
!scripts/
scripts/*
!scripts/check-build.mjs
!docker/
docker/*
!docker/quizmos.conf

# Keep local configuration and credentials out of the allowed subtrees too.
**/.*
**/*.env
**/*.env.*
**/node_modules
**/fixtures
**/test-results
**/playwright-report
**/artifacts
**/coverage
**/dist
**/secrets
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*.json
**/*service-account*.json
**/*serviceAccount*.json
**/*.log
